# Tallyleaf on Apache hosting (Hostinger, cPanel, etc.)

# The PDF reader's worker is a .mjs file; browsers only run it if it is served as JavaScript.
AddType application/javascript .mjs
AddType application/manifest+json .webmanifest
AddType image/webp .webp

# Never serve a stale app shell; the hashed files in assets/ can be cached for a long time.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css|woff2?|webp|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compress text files.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
